{
  "name": "postern-demo",
  "private": true,
  "description": "Deploys the public postern demo (demo.posternonline.com) from a pinned postern release.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "bash scripts/fetch.sh",
    "deploy": "bash scripts/deploy.sh",
